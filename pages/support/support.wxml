<view class="shell">
  <view class="language-switch">
    <text class="muted switch-label">{{commonText.language}}</text>
    <view class="switch-options">
      <block wx:for="{{languageOptions}}" wx:key="code">
        <view
          class="switch-chip {{language === item.code ? 'active' : ''}}"
          data-language="{{item.code}}"
          bindtap="switchLanguage"
        >
          <text>{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card support-hero">
    <text class="hero-title">{{text.title}}</text>
    <text class="muted summary">{{summaryText}}</text>
  </view>

  <view class="card tier-panel">
    <text class="section-title">{{text.pickTier}}</text>
    <view class="tier-grid">
      <block wx:for="{{tiers}}" wx:key="amountFen">
        <view class="tier {{selectedAmountFen === item.amountFen ? 'selected' : ''}}" data-amount="{{item.amountFen}}" bindtap="selectTier">
          <text class="tier-amount">{{commonText.currency}}{{item.amountYuan}}</text>
          <text class="tier-label">{{item.label}}</text>
          <text class="muted tier-desc">{{item.description}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card custom-panel">
    <text class="section-title">{{text.customAmount}}</text>
    <input
      class="amount-input"
      type="digit"
      placeholder="{{text.amountPlaceholder}}"
      value="{{customAmountYuan}}"
      bindinput="handleCustomAmountInput"
    />
    <text class="muted field-help">{{text.amountHelp}}</text>
  </view>

  <view class="card note-panel">
    <text class="section-title">{{text.nextTitle}}</text>
    <text class="muted note-line">{{text.step1}}</text>
    <text class="muted note-line">{{text.step2}}</text>
    <text class="muted note-line">{{text.step3}}</text>
  </view>

  <button class="primary-btn donate-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="donateNow">
    {{busy ? text.preparing : text.donateNow}}
  </button>

  <text wx:if="{{statusNote}}" class="status-note muted">{{statusNote}}</text>
</view>
