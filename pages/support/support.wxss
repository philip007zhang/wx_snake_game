.language-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.switch-label {
  font-size: 22rpx;
}

.switch-options {
  display: flex;
  gap: 10rpx;
}

.switch-chip {
  min-width: 82rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  color: #cbd5e1;
  text-align: center;
  font-size: 22rpx;
  box-sizing: border-box;
}

.switch-chip.active {
  background: linear-gradient(135deg, #22c55e, #14b8a6);
  border-color: transparent;
  color: #04111f;
  font-weight: 700;
}

.support-hero,
.tier-panel,
.custom-panel,
.note-panel {
  padding: 30rpx;
}

.summary {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.tier-panel,
.custom-panel,
.note-panel {
  margin-top: 24rpx;
}

.tier-grid {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tier {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tier.selected {
  border-color: rgba(34, 197, 94, 0.9);
  box-shadow: 0 0 0 2rpx rgba(34, 197, 94, 0.12);
}

.tier-amount {
  font-size: 42rpx;
  font-weight: 700;
}

.tier-label {
  font-size: 26rpx;
  font-weight: 600;
}

.tier-desc {
  font-size: 22rpx;
  line-height: 1.5;
}

.amount-input {
  margin-top: 20rpx;
  height: 90rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #eff6ff;
}

.field-help,
.status-note {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.note-line {
  display: block;
  margin-top: 16rpx;
  line-height: 1.6;
}

.donate-btn {
  margin-top: 28rpx;
  font-size: 30rpx;
}
