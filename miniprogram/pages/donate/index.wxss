.container {
  padding: 24rpx;
}

.panel {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.desc,
.hint {
  color: #666;
  font-size: 28rpx;
}

.amount-input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx;
}
