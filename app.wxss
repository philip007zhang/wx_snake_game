page {
  min-height: 100%;
  background:
    radial-gradient(circle at top, #1d4ed8 0%, rgba(29, 78, 216, 0) 34%),
    linear-gradient(180deg, #081122 0%, #111827 100%);
  color: #eff6ff;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.shell {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(15, 23, 42, 0.78);
  border: 2rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 28rpx;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(10rpx);
}

.hero-title {
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.1;
}

.muted {
  color: #cbd5e1;
}

.primary-btn {
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #22c55e, #14b8a6);
  color: #04111f;
  font-weight: 700;
  box-shadow: 0 18rpx 36rpx rgba(20, 184, 166, 0.24);
}

.secondary-btn {
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #eff6ff;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}
